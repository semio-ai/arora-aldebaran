{
  "ignorePatterns": [
    {
      "pattern": "^http://localhost"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://crates.io"],
      "headers": { "Accept": "text/html" }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 5,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403, 429, 503, 504]
}
